#!/usr/bin/env zsh

# check if string pyenv already in PATH
if [[ ! "pyenv" =~ "$PATH" ]]; then
    export PATH="$HOME/.pyenv/bin:${PATH}"
fi

export PYENV_SHELL=zsh

init_pyenv() {
    command pyenv rehash 2>/dev/null
    pyenv() {
      local command=${1:-}
      [ "$#" -gt 0 ] && shift
      case "$command" in
      activate|deactivate|rehash|shell)
        eval "$(pyenv "sh-$command" "$@")"
        ;;
      *)
        command pyenv "$command" "$@"
        ;;
      esac
    }
}
